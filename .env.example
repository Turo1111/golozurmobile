# Runtime env consumed by app.config.js
# NOTE: the app reads these via Constants.expoConfig.extra at runtime.

# Base URL for API and Socket.IO connections.
DB_HOST=https://api.example.com

# Currently exposed by app.config.js in expo.extra.
# No direct client-side use was verified in this repo, but it is wired today.
JWT_SECRET=replace_me_if_required_by_your_setup

# Android Google Maps API key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional iOS-specific override. If omitted in real env, app.config.js falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_IOS_API_KEY=your_ios_google_maps_api_key
